# Copy to `.env` and fill in real values. `.env` is gitignored; this file ships placeholders only.
# Frontend public vars are inlined into the bundle (public by design — the Firebase web apiKey is not a secret).

# ============ FRONTEND ============
# Expo: prefix EXPO_PUBLIC_  ·  Vite: prefix VITE_  (pick the one for your stack; keep ONE set)

# --- API ---
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.run.app
# VITE_API_BASE_URL=https://your-backend.example.run.app

# --- Firebase (web config — used by both Expo JS SDK and Vite) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============ BACKEND (Quarkus) ============
# Local dev only. In Cloud Run these come from Secret Manager / --set-env-vars, never from a file.
DB_KIND=mysql
DB_USERNAME=
DB_PASSWORD=
DB_JDBC_URL=jdbc:mysql://localhost:3306/your_db
DB_SCHEMA_STRATEGY=drop-and-create
# Path to the Firebase service-account JSON (mounted at runtime; never committed)
FIREBASE_SERVICE_ACCOUNT_LOCATION=src/main/resources/firebase-dev.json
# For endpoint smoke tests (SKILLS.md flow):
FIREBASE_API_KEY=
